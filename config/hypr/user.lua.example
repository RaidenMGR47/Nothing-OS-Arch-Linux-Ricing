-- user.lua — Glyph overrides. Loaded last from hyprland.lua, and gitignored, so `git pull`
-- never touches it. install.sh creates it from this example and manages only the blocks marked
-- with ">>> glyph:" / "<<< glyph:". Put your own settings outside those blocks.

-- Alternative binds for layouts where the backslash key needs AltGr (Spanish/Latin American,
-- German, French...). The originals stay in hyprland/keybinds.lua.
local fn = require("hyprland.functions")

-- center the active window
hl.bind("SUPER + ALT + C", hl.dsp.window.center())

-- resize to 55% x 70% of the screen, and center it (like the original bind)
hl.bind("SUPER + ALT + X", hl.dsp.window.resize(fn.resize_by_screen(55, 70)))
hl.bind("SUPER + ALT + X", hl.dsp.window.center())

-- picture-in-picture: float, pin and move the active window to the corner
hl.bind("SUPER + ALT + P", function()
    local a = hl.get_active_window()
    if not a then return end
    local pip = fn.move_actions(a) or {}
    if not a.floating then table.insert(pip, 1, hl.dsp.window.float()) end
    table.insert(pip, hl.dsp.window.pin({ action = "on", window = "address:" .. a.address }))
    for _, action in ipairs(pip) do hl.dispatch(action) end
end)

-- Examples. Uncomment what you need.
--
-- Weather location (otherwise looked up by IP):
-- hl.env("DEMONSHOT_LATLON", "19.43,-99.13")
